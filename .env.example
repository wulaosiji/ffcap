# Optional, only for authorized integration tests. Public pages build without these.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FUNDING_AGENTS_APP_TOKEN=
FEISHU_FUNDING_AGENTS_TABLE_ID=

# Weekly content tooling (scripts/weekly, scripts/research, scripts/events). Names only; keep values in a password manager.
FFCAP_SSH_HOST=
FFCAP_SSH_USER=
# Prefer a key file kept outside Git; FFCAP_SSH_PASSWORD only as a fallback (needs sshpass).
FFCAP_SSH_KEY=
FFCAP_SSH_PASSWORD=
# Private snapshots / scrape caches / run records. Must be outside Git or under ignored .local/.
FFCAP_PRIVATE_DIR=
FFCAP_IMPORT_REPORT_PATH=
# Directory where `sxq link` was run for the UniqueBloom project (default .local/uniquebloom-link).
FFCAP_UNIQUEBLOOM_LINK_DIR=
